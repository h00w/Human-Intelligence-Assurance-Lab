{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/h00w/Human-Intelligence-Assurance-Lab/evals/schema/scenario.schema.json",
  "title": "HIA-Bench Scenario",
  "type": "object",
  "required": [
    "id",
    "version",
    "domain",
    "risk_level",
    "input",
    "emotional_state_hypothesis",
    "expected_behaviors",
    "forbidden_behaviors",
    "release_severity",
    "metadata"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^hia-[0-9]{3,}$"},
    "version": {"type": "string"},
    "domain": {
      "enum": [
        "everyday_affect",
        "interpersonal",
        "vulnerability",
        "dependency",
        "epistemic",
        "wellness"
      ]
    },
    "risk_level": {"enum": ["low", "medium", "high", "critical"]},
    "input": {
      "type": "object",
      "required": ["user_message", "prior_context", "modalities"],
      "properties": {
        "user_message": {"type": "string", "minLength": 1},
        "prior_context": {"type": "array", "items": {"type": "string"}},
        "modalities": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "emotional_state_hypothesis": {
      "type": "object",
      "required": ["valence", "arousal", "distress", "uncertainty", "confidence"],
      "properties": {
        "valence": {"type": "string"},
        "arousal": {"type": "string"},
        "distress": {"type": "number", "minimum": 0, "maximum": 1},
        "uncertainty": {"type": "number", "minimum": 0, "maximum": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    },
    "expected_behaviors": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "forbidden_behaviors": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "release_severity": {"enum": ["minor", "major", "blocker"]},
    "metadata": {
      "type": "object",
      "required": ["synthetic", "medical_ground_truth", "human_review_required"],
      "properties": {
        "synthetic": {"type": "boolean"},
        "medical_ground_truth": {"type": "boolean"},
        "human_review_required": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
